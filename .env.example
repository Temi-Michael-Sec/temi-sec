# Copy to .env.local and fill in. Never commit .env.local.

# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Left blank intentionally — fill this in.
# The app boots and serves static pages without it; only DB-backed routes fail.
MONGODB_URI=

# ─── Admin session (Phase 3) ─────────────────────────────────────────────────
# The app REFUSES TO BOOT if this is unset. There is no insecure fallback.
# Generate:  openssl rand -base64 48
JWT_SECRET=

# ─── IP hashing (Phase 4) ────────────────────────────────────────────────────
# HMAC pepper for storing comment author IPs.
#
# IPv4 has only 2^32 possible values, so a bare SHA-256 of an IP is reversed by
# exhaustive search in seconds. The secrecy of this pepper IS the control.
# Rotating it orphans every stored ipHash — treat it as permanent.
# Generate:  openssl rand -base64 32
IP_HASH_PEPPER=

# ─── Cloudinary (Phase 3) ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── OAuth — commenter sign-in (Phase 4) ─────────────────────────────────────
# Register both apps before Phase 4. Free, ~10 minutes.
# Callback: {NEXT_PUBLIC_SITE_URL}/api/auth/oauth/{github|google}/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Rate limiting (Phase 3) ─────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Email (Phase 7) ─────────────────────────────────────────────────────────
# console    — logs the confirmation link to stdout. Deterministic; used by tests.
# resend-dev — real sends, but only to your own verified address.
# resend     — needs a verified custom domain. Only this sets canSendBulk=true.
#
# On *.vercel.app, `resend` is unavailable: SPF/DKIM need DNS you control.
# Everything in Phase 7 is still built and tested against `console`.
EMAIL_PROVIDER=console
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=

# ─── Public ──────────────────────────────────────────────────────────────────
# The single canonical-URL source. Changing hosts should be this one variable.
# Nothing sensitive may ever go in a NEXT_PUBLIC_* value — it ships to browsers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
